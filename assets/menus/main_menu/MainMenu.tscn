script/source = "extends TextureRect

func _ready():
	modulate.r = randf()
	var h: float = wrapf(modulate.r - 0.05, 0.0, 1.0)
	$\"%Background\".self_modulate = Color.from_hsv(h, 0.3, 0.5)
"

