[sub_resource type="GDScript" id=32]
script/source = "#BoostVFX
extends CPUParticles

var character: CharacterBase = null
var _emit_velocity: float = 0.0

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	character = get_owner() as CharacterBase
	if !is_instance_valid(character):
		queue_free()
		print(\"BoostVFX is not owned by CharacterBase\")
		return
	
	var a: float = character.acceleration + 10.0
	_emit_velocity = a * a


func _process(_delta: float) -> void:
	if Engine.get_idle_frames() % 3 != 0:
		return
	
	emitting = character.velocity.length_squared() > _emit_velocity
	
"

