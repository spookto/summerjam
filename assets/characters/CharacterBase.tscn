[sub_resource type="GDScript" id=20]
script/source = "# MotorSFX
extends AudioStreamPlayer3D

onready var owning_character: CharacterBase = owner as CharacterBase


func _ready() -> void:
	set_motor_pitch(0.0)
	seek(rand_range(0.0, 1.0))
	
	position = PlayerCamera.OFFSET_UP
	position.z += PlayerCamera.OFFSET_BACK


func _process(_delta: float) -> void:
	if Engine.get_idle_frames() % 3 != 0:
		return
	
	var pitch: float = owning_character.velocity.length() / owning_character.acceleration
	if pitch > 1.0:
		pitch = range_lerp(pitch, 1.0, 2.0, 1.0, 1.6)
	
	set_motor_pitch(pitch)


func set_motor_pitch(value: float) -> void:
	pitch_scale = clamp(value, 0.001, 1.2)
"

[sub_resource type="GDScript" id=21]
script/source = "# MotorSFX
extends AudioStreamPlayer3D

const PITCH_MIN: float = 4.0
const PITCH_MAX: float = 5.0
const PITCH_WIDTH: float = 0.3

onready var owning_character: CharacterBase = owner as CharacterBase
onready var drift_release_sfx: AudioStreamPlayer3D = $DriftReleaseSFX
onready var drift_change_sfx: AudioStreamPlayer3D = $DriftChangeSFX


var _pitch_center: float = 5.0
var _last_level: int = 0

func _ready() -> void:
	owning_character.connect(\"drift_level_changed\", self, \"_on_character_drift_level_changed\")
	_on_character_drift_level_changed(0)


func _process(_delta: float) -> void:
	if !playing || Engine.get_idle_frames() % 3 != 0:
		return
	
	var pitch: float = range_lerp(-owning_character.input_source.steer, -1.0, 1.0, _pitch_center - PITCH_WIDTH, _pitch_center + PITCH_WIDTH)
	pitch_scale = pitch
	
	if !drift_change_sfx.playing && _last_level > 2:
		drift_change_sfx.play()


func _on_character_drift_level_changed(level: int) -> void:
	if level <= 0:
		if owning_character.velocity.length_squared() > 100.0:
			drift_release_sfx.unit_db = (_last_level - 2) * 4
			drift_release_sfx.play()
		stop()
		_last_level = level
		return
	else:
		drift_change_sfx.max_db = 0.0 if level > 1 else -12.0
		drift_change_sfx.pitch_scale = max(level * 0.8, 1.2)
		drift_change_sfx.play()
		if !playing:
			play(rand_range(0.0, 10.0))
	
	
	_last_level = level
	_pitch_center = range_lerp(level, 1.0, 3.0, PITCH_MIN, PITCH_MAX)
"

