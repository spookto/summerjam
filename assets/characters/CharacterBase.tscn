[sub_resource type="GDScript" id=16]
script/source = "extends CPUParticles

var _floored: bool = false

func _process(_delta: float):
	if Engine.get_idle_frames() % 3 != 0:
		return
	emitting = _floored && owner.get(\"velocity\").length_squared() > 100

func _on_CharacterBase_floored_changed(floored: bool) -> void:
	_floored = floored


func _on_CharacterBase_floor_bounced(velocity_y: float):
	var volume_mix: float = clamp(velocity_y / 24.0, 0.0, 1.0)
	$SplashSFX.unit_db = lerp(-8.0, 0.0, volume_mix)
	print($SplashSFX.unit_db)
	$SplashSFX.play()
	$SplashParticles.emitting = true
"

