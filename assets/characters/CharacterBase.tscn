[sub_resource type="GDScript" id=29]
script/source = "#DriftVFX
extends AnimatedSprite3D

const X_OFFSET: float = 32.0 * 0.125
const MSEC_TO_SEC: float = 1.0 / 1000.0
const UPDATE_FREQUENCY: float = 0.25

onready var drift_sparks: CPUParticles = $DriftSparks

var character: CharacterBase = null

var _lvl3_time: float = -1.0
var _lvl3_h: float = 0.0
var _time: float = 0.0

const COLOR_LVL1: Color = Color.yellow
const COLOR_LVL2: Color = Color.springgreen


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	character = get_owner() as CharacterBase
	if !is_instance_valid(character):
		queue_free()
		print(\"DriftVFX is not owned by CharacterBase\")
		return
	
	character.connect(\"drift_level_changed\", self, \"_show_particles\")
	_show_particles(0)
	play(\"default\")


func _process(delta: float) -> void:
	if _lvl3_time < 0.0:
		_time = 0.0
		_lvl3_h = 0.0
		set_process(false)
		return
	
	if _time < UPDATE_FREQUENCY:
		_time += delta
		return
	
	_time = 0.0
	
	_lvl3_h = wrapf(_lvl3_h + UPDATE_FREQUENCY, 0.0, 1.0)
	_set_drift_color(Color.from_hsv(_lvl3_h, 1.0, 1.0))


func _show_particles(level: int) -> void:
	_lvl3_time = -1.0
	var offset: float = 1.5
	
	match level:
		0:
			hide()
			return
		1:
			drift_sparks.restart()
			drift_sparks.amount = 4
			_set_drift_color(COLOR_LVL1)
			pixel_size = 0.07
			offset *= 0.6
		2:
			drift_sparks.amount = 6
			_set_drift_color(COLOR_LVL2)
			pixel_size = 0.09
			offset *= 0.8
		3:
			drift_sparks.amount = 9
			_lvl3_time = Time.get_ticks_msec() * MSEC_TO_SEC
			_set_drift_color(Color.from_hsv(0.0, 1.0, 1.0))
			set_process(true)
			pixel_size = 0.125
	
	var dir: int = int(-sign(character.drift_direction))
	flip_h = character.drift_direction > 0
	position.x = offset * dir
	
	drift_sparks.direction.x = abs(drift_sparks.direction.x) * dir
	
	show()


func _set_drift_color(color: Color) -> void:
	modulate = color
	drift_sparks.color = color
"

