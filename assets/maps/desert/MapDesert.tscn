[sub_resource type="GDScript" id=3]
resource_name = "Waves"
script/source = "# MapDesert.tscn::Waves
extends Area

export var waves_direction: Vector3 = Vector3.RIGHT
export var waves_speed: float = 80.0


func _ready() -> void:
	connect(\"body_entered\", self, \"_on_body_entered\")

func _physics_process(delta: float) -> void:
	for body in get_overlapping_bodies():
		body.velocity += waves_direction * waves_speed * delta


func _on_body_entered(body: Node) -> void:
	if body is CharacterBase:
		body.velocity = body.velocity.linear_interpolate(waves_direction * waves_speed, 0.5)
"

