code = "// NOTE: Shader automatically converted from Godot Engine 3.6.rc1's SpatialMaterial.

shader_type spatial;
render_mode async_visible,blend_add,depth_draw_opaque,cull_back,diffuse_burley,specular_disabled,unshaded,vertex_lighting,shadows_disabled,ambient_light_disabled;
uniform sampler2D texture_albedo : hint_albedo;
uniform float alpha_scissor_threshold;


void vertex() {
	MODELVIEW_MATRIX = INV_CAMERA_MATRIX * mat4(CAMERA_MATRIX[0],CAMERA_MATRIX[1],CAMERA_MATRIX[2],WORLD_MATRIX[3]);
}




void fragment() {
	vec2 base_uv = UV;
	vec4 albedo_tex = texture(texture_albedo,base_uv);
	ALBEDO = albedo_tex.rgb * COLOR.rgb;
	ALPHA = albedo_tex.a * COLOR.a;
}
"

